# ─────────────────────────────────────────────────────────────────────────────
# Required environment variables
# Copy this file to .env (local) OR add these in Vercel → Project Settings →
# Environment Variables.
#
# IMPORTANT: Do NOT wrap values in quotes (single or double) when setting them
# in Vercel — paste the raw value only, e.g.:
#   Key:   ADMIN_PASSWORD
#   Value: salmamorv        ← correct
#   Value: "salmamorv"      ← WRONG – will include the quotes in the value
# ─────────────────────────────────────────────────────────────────────────────

# A long, random string used to sign session JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Admin login credentials for the CMS dashboard (/admin/login)
ADMIN_EMAIL=salmahani963@gmail.com
ADMIN_PASSWORD=salmamorv

# Cloudinary image hosting (optional – only needed for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
