# Required for admin sessions. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Admin login credentials for /admin/login.
ADMIN_EMAIL=salmahani963@gmail.com
ADMIN_PASSWORD=replace-with-a-secure-password
ADMIN_NAME=Salma Hani

# Durable CMS storage on Vercel.
# Create a Vercel Blob store, then add this token in Project Settings > Environment Variables.
BLOB_READ_WRITE_TOKEN=

# Cloudinary image hosting for admin uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional contact-form email notifications.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Salma Hani Studio <onboarding@resend.dev>
